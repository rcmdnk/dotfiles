{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "xhigh",
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "3"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(uv run python:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run prek:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Read(~/.bashrc)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.keys)",
      "Read(~/.keys)",
      "Read(./secrets/**)",
      "Bash(git reset --hard)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "docx": "name-only",
    "pptx": "name-only",
    "pdf": "name-only",
    "skill-creator": "name-only",
    "browser-use": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"~/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); line=$(printf \"%s\" \"$input\" | jq -r \"[(.model.display_name // \\\"?\\\"), (.rate_limits.five_hour.used_percentage // \\\"\\\" | tostring), (.rate_limits.five_hour.resets_at // \\\"\\\" | tostring), (.rate_limits.seven_day.used_percentage // \\\"\\\" | tostring), (.rate_limits.seven_day.resets_at // \\\"\\\" | tostring)] | @tsv\"); IFS=$(printf \"\\t\") read -r model f_pct f_rst w_pct w_rst <<EOF\n$line\nEOF\nout=\"$model\"; if [ -n \"$f_pct\" ] && [ \"$f_pct\" != \"null\" ]; then out=\"$out  |  5h ${f_pct}%\"; if [ -n \"$f_rst\" ] && [ \"$f_rst\" != \"null\" ]; then out=\"$out (resets $(date -d @\"$f_rst\" \"+%-H:%M\"))\"; fi; fi; if [ -n \"$w_pct\" ] && [ \"$w_pct\" != \"null\" ]; then out=\"$out  |  7d ${w_pct}%\"; if [ -n \"$w_rst\" ] && [ \"$w_rst\" != \"null\" ]; then out=\"$out (resets $(date -d @\"$w_rst\" \"+%a %-d %b\"))\"; fi; fi; printf \"\\033[2m%s\\033[0m\" \"$out\""
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "security-guidance@claude-plugins-official": true,
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "terminalTitleFromRename": false,
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "terminalProgressBarEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useTerminalTitle": false,
  "autoUpdates": true
}
